# @react-three/drei's published peerDependencies still say it needs
# @react-three/fiber ^8, even though drei and fiber v9 are maintained
# by the same team (pmndrs) and work together in practice — the peer
# range metadata just hasn't caught up to fiber's v9 release yet.
# This is a known, common lag in that ecosystem. legacy-peer-deps
# skips the strict peer check so `npm install` works without needing
# --legacy-peer-deps typed every time.
legacy-peer-deps=true
